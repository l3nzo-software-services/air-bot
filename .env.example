# CellSentinel Configuration
# Copy this to .env to configure custom keys if desired

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database Settings
DATABASE_PATH=cellsentinel.db

# Telecom Geolocation API Keys (Optional - built-in offline telecom repository & RF engine works without keys)
OPENCELLID_API_KEY=
MLS_API_KEY=
UNWIRED_API_KEY=

# Geolocation Defaults
DEFAULT_ACCURACY_RADIUS_METERS=1000.0
MIN_ACCURACY_RADIUS_METERS=150.0
MAX_ACCURACY_RADIUS_METERS=5000.0
