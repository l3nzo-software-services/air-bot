# CellSentinel Environment Configuration

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# SQLite Database (SQLAlchemy format)
DATABASE_URL=sqlite:///./cellsentinel_platform.db

# OpenCellID API Integration (Optional - verified local reference data works without key)
