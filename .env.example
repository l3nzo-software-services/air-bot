OPENCELLID_BASE_URL=https://opencellid.org/cell/get
API_TIMEOUT_SECONDS=4.0
API_MAX_RETRIES=2

# Security & Salt
SECRET_KEY=cellsentinel-telecom-secret-salt-2026
